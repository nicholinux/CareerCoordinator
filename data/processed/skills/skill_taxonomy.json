  "metadata": {
    "taxonomy_id": "curriculumgraph_skills_v1",
    "name": "CurriculumGraph AI Controlled Skill Taxonomy",
    "version": "1.0.0",
    "description": "Controlled skill vocabulary for mapping CSCI, MATH, and STAT courses to career-aligned technical competencies.",
    "allowed_subject_scope": [
      "CSCI",
      "MATH",
      "STAT"
    ]
  },
  "extraction_policy": {
    "allow_only_defined_skill_ids": true,
    "reject_unknown_skills": true,
    "preserve_evidence_text": true,
    "require_confidence_score": true,
    "low_confidence_threshold": 0.55,
    "review_threshold": 0.7,
    "unknown_skill_handling": "Reject labels that do not map to a defined skill_id or alias. Record rejected labels separately for manual review instead of adding them to the taxonomy automatically."
  },
